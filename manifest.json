{
  "manifest_version": 3,
  "name": "Canvas Vault",
  "description": "Archive your Canvas LMS courses: files, pages, assignments, quizzes, grades and more, exported as one ZIP per course for versioned, offline keeping.",
  "version": "2.11.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-course-downloader@pleromas",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "declarativeNetRequest",
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "*://*.instructure.com/*"
  ],
  "optional_host_permissions": [
    "*://*.canvas-user-content.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_cors",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["sanitize.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "sanitize.js",
        "zipwriter.js",
        "turndown.min.js",
        "turndown-plugin-gfm.min.js",
        "helpers.js",
        "detector.js",
        "canvas-api.js",
        "ui.js",
        "downloader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-128.png"],
      "matches": ["https://*/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canvas Vault"
  },
  "commands": {
    "download-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Download current course or open course selector"
    }
  }
}
